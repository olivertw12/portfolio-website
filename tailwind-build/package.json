{
  "name": "portfolio-build",
  "private": true,
  "description": "Builds the stylesheet used by the resume page.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.cjs -i input.css -o ../assets/tailwind.css --minify",
    "watch": "tailwindcss -c tailwind.config.cjs -i input.css -o ../assets/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}
